/* PixelForge - High Contrast (Accessibility) Theme */
QWidget { background-color: #000000; color: #ffffff; font-family: "Segoe UI", "Vazirmatn", "Microsoft YaHei", sans-serif; font-size: 14px; }
#SideNav { background-color: #000000; border-right: 2px solid #ffff00; }
#SideNav QPushButton { text-align: left; padding: 10px 14px; border: 1px solid #ffffff; border-radius: 0px; margin: 2px 8px; color: #ffffff; }
#SideNav QPushButton:hover { background-color: #333300; }
#SideNav QPushButton:checked { background-color: #ffff00; color: #000000; font-weight: 700; }
QPushButton { background-color: #ffff00; color: #000000; border: 2px solid #ffffff; padding: 8px 16px; border-radius: 0px; font-weight: 700; }
QPushButton:hover { background-color: #ffffff; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #000000; color: #ffffff; border: 2px solid #ffff00; border-radius: 0px; padding: 6px; }
QTableWidget, QListWidget, QTreeWidget { background: #000000; color: #ffffff; border: 2px solid #ffff00; }
QHeaderView::section { background: #ffff00; color: #000000; padding: 6px; border: none; font-weight: 700; }
QProgressBar { border: 2px solid #ffff00; background: #000000; color: #ffffff; }
QProgressBar::chunk { background-color: #ffff00; }
#DashboardCard { background: #000000; border: 2px solid #ffff00; padding: 14px; }
#DashboardCardValue { font-size: 22px; font-weight: 700; color: #ffff00; }
