/* PixelForge - Red Accent Theme */
QWidget { background-color: #fbebea; color: #3a0e0e; font-family: "Segoe UI", "Vazirmatn", "Microsoft YaHei", sans-serif; font-size: 13px; }
#SideNav { background-color: #7a1414; border-right: 1px solid #5e0f0f; }
#SideNav QPushButton { text-align: left; padding: 10px 14px; border: none; border-radius: 8px; margin: 2px 8px; color: #ffd9d9; }
#SideNav QPushButton:hover { background-color: #8f1a1a; }
#SideNav QPushButton:checked { background-color: #b32424; color: #ffffff; font-weight: 600; }
QPushButton { background-color: #b32424; color: white; border: none; padding: 8px 16px; border-radius: 6px; }
QPushButton:hover { background-color: #8f1a1a; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #e8bcbc; border-radius: 6px; padding: 6px; }
QTableWidget, QListWidget, QTreeWidget { background: #ffffff; border: 1px solid #e8bcbc; border-radius: 8px; }
QHeaderView::section { background: #ffd9d9; padding: 6px; border: none; font-weight: 600; color: #7a1414; }
QProgressBar::chunk { background-color: #b32424; border-radius: 6px; }
#DashboardCard { background: #ffffff; border: 1px solid #e8bcbc; border-radius: 10px; padding: 14px; }
#DashboardCardValue { font-size: 22px; font-weight: 700; color: #b32424; }
